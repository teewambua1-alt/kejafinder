rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Recommended path: /listing-photos/{ownerId}/{listingId}/{fileName}
    match /listing-photos/{ownerId}/{listingId}/{fileName} {
      // Validate file size (max 5MB) and type
      function isImage() {
        return request.resource.contentType.matches('image/.*');
      }
      function isUnder5MB() {
        return request.resource.size < 5 * 1024 * 1024;
      }

      // Cross-service read of the parent listing's moderation state, so photos
      // for draft/pending/rejected listings aren't publicly fetchable.
      // NOTE: assumes the default Firestore database ("(default)"). If this
      // project uses a named Firestore database instead, update the path
      // below to match, and verify with `firebase deploy --only storage` /
      // the emulator before relying on this in production.
      function listingIsPublic() {
        return firestore.exists(/databases/(default)/documents/listings/$(listingId)) &&
               firestore.get(/databases/(default)/documents/listings/$(listingId)).data.moderationStatus == 'approved' &&
               firestore.get(/databases/(default)/documents/listings/$(listingId)).data.availabilityStatus == 'available';
      }

      allow read: if listingIsPublic() ||
                  (request.auth != null && request.auth.uid == ownerId) ||
                  (request.auth != null && request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == ownerId && isImage() && isUnder5MB();
    }
  }
}
