rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Recommended path: /listing-photos/{ownerId}/{listingId}/{fileName}
    match /listing-photos/{ownerId}/{listingId}/{fileName} {
      // Validate file size (max 5MB) and type
      function isImage() {
        return request.resource.contentType.matches('image/.*');
      }
      function isUnder5MB() {
        return request.resource.size < 5 * 1024 * 1024;
      }
      
      // Before production, photo reads should be tied to approved listings or public CDN strategy.
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == ownerId && isImage() && isUnder5MB();
    }
  }
}
