rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == "admin"; }
    function isOwner(ownerId) { return signedIn() && request.auth.uid == ownerId; }

    match /users/{userId} {
      // Profile docs hold phone/email/location — only the owner and admins may
      // read them. Public-facing listing contact details live on the listing
      // document itself (contactName/contactPhone/whatsappPhone), so nothing
      // in the app needs to read another user's profile.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      // Admin is never a self-selectable role at signup — only an existing
      // admin (via a trusted backend process) may grant it.
      allow create: if signedIn() && request.auth.uid == userId &&
                    request.resource.data.role in ['tenant', 'landlord', 'caretaker', 'agent', 'scout'];
      // Role is fixed at signup and cannot be changed by the user afterwards,
      // so a tenant can never grant themselves landlord/agent/scout access.
      allow update: if (signedIn() && isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      match /savedListings/{listingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /listings/{listingId} {
      function isApprovedAvailableListing() {
        return resource.data.moderationStatus == 'approved' && resource.data.availabilityStatus == 'available' && resource.data.isAvailable == true;
      }

      // Fields that only an admin (or a future trusted backend process) may
      // ever set — a poster cannot self-approve, self-verify, self-feature,
      // or forge engagement counts.
      function isSystemOwnedOnCreate() {
        return request.resource.data.moderationStatus in ['draft', 'pending_review'] &&
               request.resource.data.verificationLevel == 'none' &&
               request.resource.data.isFeatured == false &&
               request.resource.data.viewsCount == 0 &&
               request.resource.data.callClicksCount == 0 &&
               request.resource.data.whatsappClicksCount == 0 &&
               request.resource.data.reportCount == 0;
      }

      function systemFieldsUnchanged() {
        return request.resource.data.ownerId == resource.data.ownerId &&
               request.resource.data.verificationLevel == resource.data.verificationLevel &&
               request.resource.data.isFeatured == resource.data.isFeatured &&
               request.resource.data.viewsCount == resource.data.viewsCount &&
               request.resource.data.callClicksCount == resource.data.callClicksCount &&
               request.resource.data.whatsappClicksCount == resource.data.whatsappClicksCount &&
               request.resource.data.reportCount == resource.data.reportCount;
      }

      function moderationTransitionAllowed() {
        // The only moderation change an owner may ever make themselves is
        // submitting a draft for review. Every other transition (approve,
        // reject, re-open, verify) is admin-only.
        return request.resource.data.moderationStatus == resource.data.moderationStatus ||
               (resource.data.moderationStatus == 'draft' && request.resource.data.moderationStatus == 'pending_review');
      }

      allow get, list: if isApprovedAvailableListing() || isOwner(resource.data.ownerId) || isAdmin();

      allow create: if signedIn() &&
                    request.auth.uid == request.resource.data.ownerId &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['landlord', 'caretaker', 'agent', 'scout'] &&
                    isSystemOwnedOnCreate();

      allow update: if isAdmin() ||
                    (isOwner(resource.data.ownerId) &&
                     (resource.data.moderationStatus == 'draft' || resource.data.moderationStatus == 'pending_review') &&
                     systemFieldsUnchanged() &&
                     moderationTransitionAllowed());

      allow delete: if isAdmin();

      match /photos/{photoId} {
        allow read: if isApprovedAvailableListing() || isOwner(get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId) || isAdmin();
        allow write: if isOwner(get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId) || isAdmin();
      }
    }

    match /listingReports/{reportId} {
      allow create: if signedIn() &&
                    request.resource.data.reporterId == request.auth.uid &&
                    request.resource.data.status == 'new' &&
                    request.resource.data.reason in ['fake_listing', 'already_taken', 'wrong_price', 'wrong_location', 'wrong_photos', 'scam_request', 'unsafe_property', 'hidden_agent_fee', 'duplicate', 'other'];
      allow read, update, delete: if isAdmin();
    }
  }
}
